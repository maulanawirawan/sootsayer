{
  "enabled": true,
  "name": "Report lint",
  "description": "After a crosscheck report is saved, check it against the house rule before a human reads it.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["reports/*.md", "reports/**/*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A crosscheck report was just saved (reports/*.md). Validate it against the house rule before a human reads it:\n1. The 'Backed by evidence' section lists only items labeled verified.\n2. Every listed item has a receipt line with an id, a label, sources, a fingerprint, and a checked-at time.\n3. No needs-evidence or likely-false-positive item appears in 'Backed by evidence'.\n4. The summary counts match the number of items actually listed in each section.\nIf everything holds, reply with a one-line PASS. Otherwise list each problem with the item id and what to fix. Keep the wording plain; no security jargon."
  }
}
