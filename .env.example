# Copy to .env (git-ignored) and fill in. Only used at build time on your machine.
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional, build time only: the forecast-as-issued replay (build_forecast).
# Free Copernicus Atmosphere Data Store account -> your profile -> API key.
ADS_API_KEY=
